@page "/change-password"
@attribute [Authorize]

@inject IPatientAccountService AccountService
@inject NavigationManager Navigation
@inject IStringLocalizer<ChangePassword> Localizer

<PageTitle>@Localizer["change_password"]</PageTitle>

<h1>@Localizer["change_password"]</h1>
<p>@Localizer["change_password_info"]</p>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger" role="alert">@_error</div>
}

@if (ChangePasswordForm is not null)
{
    <div class="row">
        <div class="col-6">
            <EditForm Model="ChangePasswordForm" FormName="change-password" OnValidSubmit="HandleChangePasswordAsync" method="post">
                <DataAnnotationsValidator />

                <div class="mb-3">
                    <label for="password" class="form-label required">@Localizer["new_password_label"]</label>
                    <InputText id="password" @bind-Value="ChangePasswordForm.NewPassword" type="password" class="form-control" />
                    <ValidationMessage For="() => ChangePasswordForm.NewPassword" class="text-danger" />
                </div>

                <div class="mb-3">
                    <label for="password-confirm" class="form-label required">@Localizer["new_password_confirm_label"]</label>
                    <InputText id="password-confirm" @bind-Value="ChangePasswordForm.NewPasswordConfirm" type="password" class="form-control" />
                    <ValidationMessage For="() => ChangePasswordForm.NewPasswordConfirm" class="text-danger" />
                </div>

                <button type="submit" class="btn btn-primary">@Localizer["change"]</button>
            </EditForm>
        </div>
    </div>
}

@code {
    [SupplyParameterFromForm]
    public ChangePasswordForm? ChangePasswordForm { get; set; }

    private string? _error;

    protected override void OnInitialized() => ChangePasswordForm ??= new ChangePasswordForm();

    private async Task HandleChangePasswordAsync()
    {
        AccountResult result = await AccountService.ChangePasswordAsync(ChangePasswordForm!);
        if (!result.Success)
        {
            _error = result.ErrorMessage;
            return;
        }

        Navigation.NavigateTo("/me?msg=passwordChanged", forceLoad: true);
    }
}
