@attribute [Authorize(Roles = "Patient")]
@rendermode InteractiveServer
@inject IContraIndicationService ContraIndicationService
@inject ICurrentPatientService CurrentPatient
@inject NavigationManager Navigation
@inject IStringLocalizer<ContraIndications> Localizer

<section class="mt-5">
    <div class="d-flex justify-content-between align-items-center gap-3 mb-3">
        <div>
            <h2 class="h4 mb-1">@Localizer["Heading"]</h2>
            <p class="text-muted mb-0">@Localizer["Intro"]</p>
        </div>
        <button type="button" class="btn btn-outline-secondary" @onclick="LoadContraIndicationsAsync" disabled="@isLoading">
            @Localizer["Refresh"]
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger" role="alert">@errorMessage</div>
    }

    @if (isLoading)
    {
        <p>@Localizer["LoadingContraIndications"]</p>
    }
    else if (!contraIndications.Any())
    {
        <p class="text-muted">@Localizer["NoContraIndications"]</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped align-middle">
                <thead>
                    <tr>
                        <th>@Localizer["MedicationColumn"]</th>
                        <th>@Localizer["ActiveSubstanceColumn"]</th>
                        <th>@Localizer["PrescriptionDateColumn"]</th>
                        <th>@Localizer["ContraIndicationsColumn"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in contraIndications)
                    {
                        <tr>
                            <td>@item.MedicineNames</td>
                            <td>@item.ActiveSubstance</td>
                            <td>@item.PrescriptionDates</td>
                            <td>
                                @if (item.IsAvailable)
                                {
                                    <span style="white-space: pre-line;">@item.Text</span>
                                }
                                else
                                {
                                    <span class="text-muted">@Localizer["NoFkInformation"]</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@code {
    private bool isLoading = true;
    private string? errorMessage;
    private IReadOnlyList<ContraIndicationListItem> contraIndications = [];

    protected override async Task OnInitializedAsync()
    {
        await LoadContraIndicationsAsync();
    }

    private async Task LoadContraIndicationsAsync()
    {
        isLoading = true;
        errorMessage = null;
        contraIndications = [];

        var patientId = await CurrentPatient.GetPatientIdAsync();
        if (patientId is null)
        {
            Navigation.NavigateTo("/login", forceLoad: true);
            return;
        }

        try
        {
            contraIndications = await ContraIndicationService.GetForPatientAsync(patientId.Value);
        }
        catch
        {
            errorMessage = Localizer["ContraIndicationsFetchFailed"];
        }

        isLoading = false;
    }
}
