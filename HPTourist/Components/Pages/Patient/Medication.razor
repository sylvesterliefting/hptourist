@page "/patient/medication"
@attribute [Authorize(Roles = "Patient")]
@rendermode InteractiveServer
@inject IPatientMedicationService PatientMedications
@inject ICurrentPatientService CurrentPatient
@inject NavigationManager Navigation
@inject IStringLocalizer<Medication> Localizer

<PageTitle>@Localizer["PageTitle"]</PageTitle>

<div class="d-flex justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="mb-1">@Localizer["Heading"]</h1>
        <p class="text-muted mb-0">@Localizer["Intro"]</p>
    </div>
    <div class="d-flex gap-2">
        <a href="/patient/repeat-prescription/request" class="btn btn-primary">@Localizer["RequestRepeatPrescription"]</a>
        <a href="/patient/medication/add" class="btn btn-outline-primary">@Localizer["AddMedication"]</a>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}

@if (isLoading)
{
    <p>@Localizer["LoadingMedication"]</p>
}
else
{
    <section class="mb-5">
        <h2 class="h4">@Localizer["PrescribedMedication"]</h2>

        @if (overview.PrescribedMedications.Any())
        {
            <div class="table-responsive">
                <table class="table table-striped align-middle">
                    <thead>
                        <tr>
                            <th>@Localizer["MedicationColumn"]</th>
                            <th>@Localizer["ActiveSubstanceColumn"]</th>
                            <th>@Localizer["FormColumn"]</th>
                            <th>@Localizer["PrescriptionDateColumn"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var medication in overview.PrescribedMedications)
                        {
                            <tr>
                                <td>@medication.Name</td>
                                <td>@medication.ActiveSubstance</td>
                                <td>@medication.PharmaceuticalForm</td>
                                <td>@medication.PrescribedAt.ToString("dd-MM-yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="text-muted">@Localizer["NoPrescribedMedication"]</p>
        }
    </section>

    <section>
        <h2 class="h4">@Localizer["SelfAddedMedication"]</h2>

        @if (overview.SelfAddedMedications.Any())
        {
            <div class="table-responsive">
                <table class="table table-striped align-middle">
                    <thead>
                        <tr>
                            <th>@Localizer["MedicationColumn"]</th>
                            <th>@Localizer["ActiveSubstanceColumn"]</th>
                            <th>ATC-code</th>
                            <th>@Localizer["FormColumn"]</th>
                            <th>@Localizer["DateColumn"]</th>
                            <th class="text-end">@Localizer["ActionsColumn"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var medication in overview.SelfAddedMedications)
                        {
                            <tr>
                                <td>@medication.Name</td>
                                <td>@medication.ActiveSubstance</td>
                                <td>@FormatAtcCode(medication.AtcCode)</td>
                                <td>@medication.PharmaceuticalForm</td>
                                <td>@medication.CreatedAt.ToString("dd-MM-yyyy")</td>
                                <td class="text-end">
                                    <div class="btn-group" role="group" aria-label="@Localizer["MedicationActions"]">
                                        <a class="btn btn-sm btn-outline-primary" href="@($"/patient/medication/edit/{medication.Id}")">@Localizer["Edit"]</a>
                                        <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => DeleteMedicationAsync(medication.Id)">
                                            @Localizer["Delete"]
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="text-muted">@Localizer["NoSelfAddedMedication"]</p>
        }
    </section>

    <ContraIndications />
}

@code {
    private bool isLoading = true;
    private string? errorMessage;
    private PatientMedicationOverview overview = new([], []);

    protected override async Task OnInitializedAsync()
    {
        await LoadMedicationAsync();
    }

    private async Task LoadMedicationAsync()
    {
        isLoading = true;
        errorMessage = null;

        var patientId = await CurrentPatient.GetPatientIdAsync();
        if (patientId is null)
        {
            Navigation.NavigateTo("/login", forceLoad: true);
            return;
        }

        overview = await PatientMedications.GetOverviewAsync(patientId.Value);

        isLoading = false;
    }

    private async Task DeleteMedicationAsync(Guid medicationId)
    {
        var patientId = await CurrentPatient.GetPatientIdAsync();
        if (patientId is null)
        {
            Navigation.NavigateTo("/login", forceLoad: true);
            return;
        }

        var result = await PatientMedications.DeleteMedicationAsync(patientId.Value, medicationId);
        if (!result.Success)
        {
            errorMessage = result.ErrorMessage ?? Localizer["MedicationNotFound"];
            return;
        }

        await LoadMedicationAsync();
    }

    private static string FormatAtcCode(string atcCode)
    {
        return string.IsNullOrWhiteSpace(atcCode) ? "-" : atcCode;
    }
}
