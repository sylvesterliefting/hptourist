@page "/patient/medication/edit/{MedicineId:guid}"
@attribute [Authorize(Roles = "Patient")]
@rendermode InteractiveServer
@inject IPatientMedicationService PatientMedications
@inject ICurrentPatientService CurrentPatient
@inject NavigationManager Navigation
@inject IStringLocalizer<EditMedication> Localizer

<PageTitle>@Localizer["PageTitle"]</PageTitle>

<h1>@Localizer["Heading"]</h1>
<p class="text-muted">@Localizer["Intro"]</p>

@if (isLoading)
{
    <p>@Localizer["LoadingMedication"]</p>
}
else if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
    <a href="/patient/medication" class="btn btn-secondary">@Localizer["BackToMedication"]</a>
}
else
{
    <EditForm Model="medicationForm" OnValidSubmit="HandleValidSubmitAsync">
        <DataAnnotationsValidator />
        <ValidationSummary class="text-danger" />

        <div class="mb-3">
            <label for="name" class="form-label">@Localizer["MedicationName"]</label>
            <InputText id="name" class="form-control" @bind-Value="medicationForm.Name" autocomplete="off" />
            <ValidationMessage For="() => medicationForm.Name" class="text-danger" />
        </div>

        <div class="mb-3">
            <label for="active-substance" class="form-label">@Localizer["ActiveSubstance"]</label>
            <InputText id="active-substance" class="form-control" @bind-Value="medicationForm.ActiveSubstance" autocomplete="off" />
            <ValidationMessage For="() => medicationForm.ActiveSubstance" class="text-danger" />
        </div>

        <div class="mb-3">
            <label for="atc-code" class="form-label">@Localizer["AtcCode"]</label>
            <InputText id="atc-code" class="form-control" @bind-Value="medicationForm.AtcCode" autocomplete="off" />
            <ValidationMessage For="() => medicationForm.AtcCode" class="text-danger" />
        </div>

        <div class="mb-3">
            <label for="pharmaceutical-form" class="form-label">@Localizer["PharmaceuticalForm"]</label>
            <InputSelect id="pharmaceutical-form" class="form-select" @bind-Value="medicationForm.PharmaceuticalForm">
                <option value="">@Localizer["ChooseForm"]</option>
                <option value="Tablet">@Localizer["FormTablet"]</option>
                <option value="Capsule">@Localizer["FormCapsule"]</option>
                <option value="Drank">@Localizer["FormLiquid"]</option>
                <option value="Injectie">@Localizer["FormInjection"]</option>
                <option value="Zalf">@Localizer["FormOintment"]</option>
                <option value="Druppels">@Localizer["FormDrops"]</option>
                <option value="Inhalatie">@Localizer["FormInhalation"]</option>
                <option value="Anders">@Localizer["FormOther"]</option>
            </InputSelect>
            <ValidationMessage For="() => medicationForm.PharmaceuticalForm" class="text-danger" />
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">@Localizer["Save"]</button>
            <a href="/patient/medication" class="btn btn-secondary">@Localizer["Cancel"]</a>
        </div>
    </EditForm>
}

@code {
    [Parameter]
    public Guid MedicineId { get; set; }

    private MedicineForm medicationForm = new();
    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        var patientId = await CurrentPatient.GetPatientIdAsync();
        if (patientId is null)
        {
            Navigation.NavigateTo("/login", forceLoad: true);
            return;
        }

        var medication = await PatientMedications.GetMedicationAsync(patientId.Value, MedicineId);
        if (medication is null)
        {
            errorMessage = Localizer["MedicationNotFound"];
            isLoading = false;
            return;
        }

        medicationForm = new MedicineForm
        {
            Name = medication.Name,
            ActiveSubstance = medication.ActiveSubstance,
            AtcCode = medication.AtcCode,
            PharmaceuticalForm = medication.PharmaceuticalForm,
        };
        isLoading = false;
    }

    private async Task HandleValidSubmitAsync()
    {
        var patientId = await CurrentPatient.GetPatientIdAsync();
        if (patientId is null)
        {
            Navigation.NavigateTo("/login", forceLoad: true);
            return;
        }

        var result = await PatientMedications.UpdateMedicationAsync(patientId.Value, MedicineId, medicationForm);
        if (!result.Success)
        {
            errorMessage = result.ErrorMessage ?? Localizer["MedicationNotFound"];
            return;
        }

        Navigation.NavigateTo("/patient/medication");
    }
}
